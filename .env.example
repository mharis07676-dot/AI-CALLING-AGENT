# App
APP_NAME=Synas Labs AI Agents
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1
MAX_CONCURRENT_CALLS=10

# Database (Railway provides DATABASE_URL / DATABASE_URL_SYNC in production)
DATABASE_URL=postgresql+asyncpg://synas:synas@localhost:5432/synas_agents
DATABASE_URL_SYNC=postgresql://synas:synas@localhost:5432/synas_agents

# Redis (Railway provides REDIS_URL in production)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI (values come from Railway in production — leave blank locally)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Realtime built-in voice (alloy|ash|ballad|coral|echo|sage|shimmer|verse|marin|cedar).
# marin/cedar are OpenAI's recommended natural voices for gpt-realtime.
OPENAI_REALTIME_VOICE=marin
OPENAI_WEBHOOK_SECRET=
OPENAI_SIP_PROJECT_ID=
# Platform webhook URL (set in OpenAI Project > Webhooks):
# https://<YOUR-RAILWAY-BACKEND>/api/v1/webhooks/openai/<tenant_slug>/inbound
# Event type: realtime.call.incoming

# Call recording (Twilio captures actual SIP media — this app does not see RTP)
CALL_RECORDING_ENABLED=false
CALL_RECORDING_FORMAT=mp3
CALL_RECORDING_MODE=stereo
CALL_RECORDING_STORAGE=local
CALL_RECORDING_DIR=recordings
CALL_RECORDING_RETENTION_DAYS=90
CALL_RECORDING_NOTICE_ENABLED=false
CALL_RECORDING_NOTICE_TEXT=This call may be recorded for quality and training.

# Recording object storage (local | backblaze_b2 | s3_compatible)
RECORDING_STORAGE_PROVIDER=local
# Backblaze B2 (S3-compatible) — preferred production storage to avoid Railway disk cost
B2_ENDPOINT=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=auto
# Generic S3-compatible aliases (Wasabi / R2 / AWS later)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# Twilio (Railway)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_AUTH_TOKEN=

# Human handoff / live agent transfer
# Destination is ALWAYS this env number — the model cannot choose a phone number.
HUMAN_HANDOFF_ENABLED=true
HUMAN_HANDOFF_NUMBER=+923348587676
HUMAN_HANDOFF_TIMEOUT_SECONDS=25
# Public HTTPS URL of this backend (Railway service URL). Twilio fetches TwiML from it.
PUBLIC_BASE_URL=https://your-backend.up.railway.app

# SIP / Telephony
SIP_PROVIDER_API_KEY=
SIP_PROVIDER_BASE_URL=
SIP_PROVIDER_SIP_URL=
SIP_TRUNK_ID=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=

# CORS
CORS_ORIGINS=http://localhost:3000

# Dashboard (public API base only — never put secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
