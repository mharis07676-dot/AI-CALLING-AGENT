# App
APP_NAME=Synas Labs AI Agents
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1
MAX_CONCURRENT_CALLS=10

# Database
DATABASE_URL=postgresql+asyncpg://synas:synas@localhost:5432/synas_agents
DATABASE_URL_SYNC=postgresql://synas:synas@localhost:5432/synas_agents

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_WEBHOOK_SECRET=

# SIP / Telephony
SIP_PROVIDER_API_KEY=
SIP_PROVIDER_BASE_URL=
SIP_TRUNK_ID=
OPENAI_SIP_PROJECT_ID=

# CORS
CORS_ORIGINS=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
